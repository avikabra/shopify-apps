# --- Shopify app credentials (from the Shopify Dev Dashboard / Partner Dashboard) ---
# Required for REAL mode. If SHOPIFY_API_KEY is empty, the app runs in MOCK mode.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2026-07
# Public base URL of this app, e.g. https://agent-catalog-fixer.up.railway.app (no trailing slash).
# Used for OAuth callback, webhooks, and App Bridge. Must be HTTPS in production.
APP_URL=http://localhost:8000

# --- Provider modes. Mock modes use in-memory fixtures; no network, no credentials. ---
# "real" | "mock" (mock is also the automatic fallback when no API key is set)
SHOPIFY_CLIENT_MODE=mock

# --- Database ---
# Postgres in production, e.g. postgresql+psycopg://user:pass@host:5432/agent_catalog_fixer
# SQLite is fine for local dev/tests: sqlite:///./dev.db
DATABASE_URL=sqlite:///./dev.db
# Set to 1 in production: skip dev-style auto table creation (run migrations instead).
SKIP_AUTO_CREATE_TABLES=0

# --- Plans ---
# Default plan assigned to newly installed shops: "free" | "pro"
DEFAULT_PLAN=free
# Free-tier cap on products scored per audit run.
FREE_PLAN_PRODUCT_LIMIT=25
# Shopify Billing API test mode: 1 = test charges (default), 0 = real charges.
SHOPIFY_BILLING_TEST=1

# --- Security: 32-byte urlsafe-base64 Fernet key. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Server ---
PORT=8000
