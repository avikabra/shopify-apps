# --- Server ---
PORT=3000
# Public base URL of the app (no trailing slash). Used for OAuth callbacks,
# webhook delivery and billing return URLs.
HOST=https://your-app.fly.dev

# --- Shopify (from the Partner dashboard app settings) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_products,read_inventory,write_inventory,read_locations
SHOPIFY_API_VERSION=2025-10

# --- Database ---
DATABASE_URL=postgresql://spo:spodev@localhost:5432/spo_dev

# --- Billing (freemium: Free $0 / Starter $9 / Growth $19, see src/lib/plans.ts) ---
# Set to 'true' in production to enforce plan limits (SKU caps, feature gates).
# Leave 'false' in dev/mock mode — all features stay open.
BILLING_ENFORCE=false

# --- Email (PO PDFs to suppliers, low-stock digests) ---
# 'log' prints emails to stdout (dev default). 'smtp' sends for real.
EMAIL_MODE=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Simple Purchase Orders <noreply@example.com>

# --- Local development without Shopify credentials ---
# Set both to run the full app against a local fixture shop:
# SHOPIFY_MOCK=true
# DEV_FAKE_SHOP=demo.myshopify.com
# NEVER set DEV_FAKE_SHOP in production.
