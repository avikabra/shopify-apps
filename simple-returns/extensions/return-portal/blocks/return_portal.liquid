<div
  id="simple-returns-portal"
  data-shop="{{ shop.permanent_domain }}"
  data-api="{{ block.settings.api_url | escape }}"
>
  <noscript><p>Please enable JavaScript to start a return.</p></noscript>
</div>
<link rel="stylesheet" href="{{ 'return-portal.css' | asset_url }}">
<script src="{{ 'return-portal.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Return portal",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "api_url",
      "label": "Simple Returns API URL",
      "info": "The https URL where the Simple Returns app is hosted (no trailing slash).",
      "placeholder": "https://simple-returns.fly.dev"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Start a return or exchange"
    }
  ]
}
{% endschema %}
