# --- Shopify app credentials (from the Shopify Dev Dashboard / Partner Dashboard) ---
# Required for REAL mode. If SHOPIFY_API_KEY is empty, the app runs in MOCK mode.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2026-07
# Public base URL of this app, e.g. https://simple-returns.fly.dev (no trailing slash).
# Used for OAuth callback, webhooks, and App Bridge. Must be HTTPS in production.
APP_URL=http://localhost:8000

# --- Provider modes. Mock modes use in-memory fixtures; no network, no credentials. ---
# "real" | "mock" (mock is also the automatic fallback when no API key is set)
SHOPIFY_CLIENT_MODE=mock
# "real" | "mock"  (EasyPost return labels)
SHIPPING_PROVIDER=mock
# "console" | "smtp"  (console just logs; smtp needs the settings below)
EMAIL_PROVIDER=console

# --- Database ---
# Postgres in production, e.g. postgresql+psycopg://user:pass@host:5432/simple_returns
# SQLite is fine for local dev/tests: sqlite:///./dev.db
DATABASE_URL=sqlite:///./dev.db
# Set to 1 in production: skip dev-style auto table creation, use Alembic instead.
SKIP_AUTO_CREATE_TABLES=0

# --- Plans ---
# Default plan assigned to newly installed shops: "starter" | "growth"
DEFAULT_PLAN=starter

# --- Security: 32-byte urlsafe-base64 Fernet key. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- EasyPost (real mode only). Labels are billed to the merchant via pass-through. ---
EASYPOST_API_KEY=
# Optional: restrict to specific carrier accounts (comma-separated EasyPost carrier account IDs)
EASYPOST_CARRIER_ACCOUNTS=

# --- Email (real mode: EMAIL_PROVIDER=smtp) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM="Simple Returns <returns@example.com>"

# --- Server ---
PORT=8000
